# << household.name >> — Home Assistant configuration
# GENERATED by the GigaHA Starter Kit (build.py) from household.yaml.
# Edit household.yaml and rebuild instead of editing generated files.

# Loads default set of integrations. Do not remove.
default_config:

frontend:
  themes: !include_dir_merge_named themes

homeassistant:
  packages: !include_dir_named packages

automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

# Kit dashboards are YAML-managed (rebuilt from household.yaml). Your own UI dashboards are untouched.
lovelace:
  dashboards:
<% for d in dashboards %>
    << d.url >>:
      mode: yaml
      filename: dashboards/<< d.file >>
      title: << d.title >>
      icon: << d.icon >>
      show_in_sidebar: true
<% if d.admin %>
      require_admin: true
<% endif %>
<% endfor %>

recorder:
  exclude:
    entities:
      - sensor.bank_history_recent   # list for the dashboard; the Bank History calendar keeps the record
