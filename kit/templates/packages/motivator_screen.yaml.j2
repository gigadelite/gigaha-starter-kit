# Motivator screen: << s.name >> (<< s.type >>)
# GENERATED by build.py from household.yaml. Edit household.yaml and rebuild; don't edit this file.
#
# This screen spends only from its own bank. Earned minutes come in from:
#   << s.earners | map(attribute='name') | join(', ') or 'nobody (no person has this screen in earn_to)' >> (shares: << s.earners | map(attribute='earn_to') | map(attribute=s.id) | join('/') >>%)
# Optional free time per day comes first (never banked). Time past it comes out of the bank.
# Gate off = unlimited, and use doesn't draw from the bank.
<% if dry_run %>
# DRY RUN is on (household.yaml): limits are calculated and logged, never applied.
<% endif %>

input_boolean:
  << s.id >>_gate:
    name: "<< s.name >> needs earned time"
    icon: << s.icon >>
  << s.id >>_free_enabled:
    name: "<< s.name >> free daily time"
    icon: mdi:gift-outline

input_number:
  << s.id >>_free_minutes:
    name: "<< s.name >> free minutes / day"
    icon: << s.icon >>
    min: 0
    max: 240
    step: 15
    mode: slider
    unit_of_measurement: min
  # Quick add for today only (added to free time; cleared at midnight, never banked)
  << s.id >>_extra_today:
    name: "<< s.name >> extra time today"
    icon: mdi:timer-plus-outline
    min: 0
    max: 600
    step: 1
    mode: box
    unit_of_measurement: min
  << s.id >>_bank:
    name: "<< s.name >> bank"
    icon: mdi:piggy-bank
    min: 0
    max: 100000
    step: 1
    mode: box
    unit_of_measurement: min
  << s.id >>_bonus_bank:
    name: "<< s.name >> bonus bank"
    icon: mdi:gift
    min: 0
    max: 100000
    step: 1
    mode: box
    unit_of_measurement: min
  << s.id >>_bank_cap:
    name: "<< s.name >> bank cap"
    icon: mdi:safe
    min: 30
    max: 600
    step: 30
    mode: slider
    unit_of_measurement: min

<% if s.media %>
sensor:
  - platform: history_stats
    name: "<< s.id >> counted hours today"   # name sets the entity ID: sensor.<< s.id >>_counted_hours_today
    unique_id: << uid >>_<< s.id >>_counted_hours_today
    entity_id: binary_sensor.<< s.id >>_counted_playing
    state: "on"
    type: time
    start: "{{ today_at() }}"
    end: "{{ now() }}"

<% endif %>
template:
<% if s.media %>
  # What's running while the << s.name >> is on (<< s.app_attrs | join(' or ') >> from << s.entities.media_player >>).
  # Many apps misreport play/pause, so anything running counts while it's on, except exempt_apps.
  # Nothing running (e.g. the home screen with no title) doesn't count.
  - sensor:
      - name: "<< s.name >> active app"
        unique_id: << uid >>_<< s.id >>_active_app
        default_entity_id: sensor.<< s.id >>_active_app
        icon: mdi:television-play
        state: >
          {% set mp = '<< s.entities.media_player >>' %}
          {% set app = <% for a in s.app_attrs %>state_attr(mp, '<< a >>')<% if not loop.last %> or <% endif %><% endfor %> %}
          {{ app if states(mp) in << s.on_states | tojson >> and app else 'idle' }}
  - binary_sensor:
      - name: "<< s.name >> counted playing"
        unique_id: << uid >>_<< s.id >>_counted_playing
        default_entity_id: binary_sensor.<< s.id >>_counted_playing
        icon: mdi:television-play
        state: >
          {% set app = states('sensor.<< s.id >>_active_app') %}
          {% set exempt = << s.exempt_apps | map('lower') | list | tojson >> %}
          {{ app not in ['idle', 'unknown', 'unavailable'] and not (exempt | select('in', app | lower) | list) }}
<% endif %>
  - sensor:
      # Earned today for this screen: each person's earned minutes x their share
      - name: "<< s.name >> earned today"
        unique_id: << uid >>_<< s.id >>_earned_today
        default_entity_id: sensor.<< s.id >>_earned_today
        unit_of_measurement: min
        state_class: total
        icon: mdi:heart-plus
        state: >
          {{ (0<% for p in s.earners %> + (states('sensor.<< p.id >>_earned_today') | float(0)) * << p.earn_to[s.id] / 100 >><% endfor %>) | round(1) }}

      - name: "<< s.name >> banked"
        unique_id: << uid >>_<< s.id >>_banked
        default_entity_id: sensor.<< s.id >>_banked
        unit_of_measurement: min
        icon: mdi:piggy-bank
        state: "{{ (states('input_number.<< s.id >>_bank') | int(0)) + (states('input_number.<< s.id >>_bonus_bank') | int(0)) }}"
        attributes:
          regular: "{{ states('input_number.<< s.id >>_bank') | int(0) }}"
          bonus: "{{ states('input_number.<< s.id >>_bonus_bank') | int(0) }}"

      # Free time today (0 when free time is off) + today's quick-add extra
      - name: "<< s.name >> daily allotment"
        unique_id: << uid >>_<< s.id >>_daily_allotment
        default_entity_id: sensor.<< s.id >>_daily_allotment
        unit_of_measurement: min
        icon: mdi:gift-outline
        state: >
          {{ (states('input_number.<< s.id >>_free_minutes') | int(0) if is_state('input_boolean.<< s.id >>_free_enabled', 'on') else 0)
             + (states('input_number.<< s.id >>_extra_today') | int(0)) }}

      - name: "<< s.name >> used today"
        unique_id: << uid >>_<< s.id >>_used_today
        default_entity_id: sensor.<< s.id >>_used_today
        unit_of_measurement: min
        state_class: total
        icon: << s.icon >>
        state: >
<% if s.type == 'nintendo_switch' %>
          {# Nintendo's sensor keeps yesterday's value until the console reports today #}
          {% set u = states['<< s.entities.used >>'] %}
          {{ (u.state | float(0) | int) if u is not none and as_local(u.last_changed).date() == now().date() else 0 }}
<% else %>
          {{ ((states('sensor.<< s.id >>_counted_hours_today') | float(0)) * 60) | round(0) | int }}
<% endif %>

      - name: "<< s.name >> free minutes left"
        unique_id: << uid >>_<< s.id >>_free_left
        default_entity_id: sensor.<< s.id >>_free_left
        unit_of_measurement: min
        icon: mdi:gift-outline
        state: >
          {{ [(states('sensor.<< s.id >>_daily_allotment') | float(0)) - (states('sensor.<< s.id >>_used_today') | float(0)), 0] | max | int }}

      # Use past the free time (only charged while the gate is on)
      - name: "<< s.name >> over allotment"
        unique_id: << uid >>_<< s.id >>_over_allotment
        default_entity_id: sensor.<< s.id >>_over_allotment
        unit_of_measurement: min
        icon: mdi:timer-alert-outline
        state: >
          {% if is_state('input_boolean.<< s.id >>_gate', 'on') %}
            {{ [(states('sensor.<< s.id >>_used_today') | float(0)) - (states('sensor.<< s.id >>_daily_allotment') | float(0)), 0] | max | int }}
          {% else %}0{% endif %}

      # Bank right now: bank + bonus + earned today - used past free time
      - name: "<< s.name >> minutes available"
        unique_id: << uid >>_<< s.id >>_available
        default_entity_id: sensor.<< s.id >>_available
        unit_of_measurement: min
        icon: mdi:timer-sand
        state: >
          {{ ((states('input_number.<< s.id >>_bank') | float(0)) +
              (states('input_number.<< s.id >>_bonus_bank') | float(0)) +
              (states('sensor.<< s.id >>_earned_today') | float(0)) -
              (states('sensor.<< s.id >>_over_allotment') | float(0))) | int }}

      # Time left today = free time left + what's left in the bank
      - name: "<< s.name >> minutes left"
        unique_id: << uid >>_<< s.id >>_minutes_left
        default_entity_id: sensor.<< s.id >>_minutes_left
        unit_of_measurement: min
        icon: mdi:timer-outline
        state: >
          {{ ((states('sensor.<< s.id >>_free_left') | float(0)) +
              ([states('sensor.<< s.id >>_available') | float(0), 0] | max)) | int }}
<% if s.type == 'nintendo_switch' %>

      # Limit sent to the console: free time + bank + bonus + earned today,
      # rounded down to Nintendo's step size and capped at Nintendo's max
      - name: "<< s.name >> play limit today"
        unique_id: << uid >>_<< s.id >>_play_limit
        default_entity_id: sensor.<< s.id >>_play_limit
        unit_of_measurement: min
        icon: mdi:timer-lock
        state: >
          {% set num = '<< s.entities.limit >>' %}
          {% set bank = (states('input_number.<< s.id >>_bank') | float(0)) +
                        (states('input_number.<< s.id >>_bonus_bank') | float(0)) +
                        (states('sensor.<< s.id >>_earned_today') | float(0)) %}
          {% set total = (states('sensor.<< s.id >>_daily_allotment') | float(0)) + ([bank, 0] | max) %}
          {% set step = state_attr(num, 'step') | float(1) %}
          {% set step = step if step > 0 else 1 %}
          {% set cap = state_attr(num, 'max') | float(360) %}
          {{ [((total / step) | int) * step, cap] | min | int }}
<% endif %>

utility_meter:
  << s.id >>_earned_week:
    source: sensor.<< s.id >>_earned_today
    cron: "0 0 * * 0"
    periodically_resetting: true
  << s.id >>_used_week:
    source: sensor.<< s.id >>_used_today
    cron: "0 0 * * 0"
    periodically_resetting: true

<% if s.type == 'apple_tv' %>
script:
  << s.id >>_reconnect:
    alias: "<< s.name >>: reconnect"
    icon: mdi:television-classic
    mode: single
    sequence:
      - action: homeassistant.reload_config_entry
        data:
          entry_id: "{{ config_entry_id('<< s.entities.media_player >>') }}"

<% endif %>
automation:
<% if s.type == 'nintendo_switch' %>
  # Push the limit every 5 minutes (not on every bank change, to avoid churn)
  - id: << uid >>_<< s.id >>_gate_apply
    alias: "<< s.name >>: limit = free time + bank"
    mode: queued
    max: 3
    triggers:
      - trigger: state
        entity_id: input_boolean.<< s.id >>_gate
        to: "on"
<% if dry_run %>
      # Dry run: log only when the limit would change
      - trigger: state
        entity_id: sensor.<< s.id >>_play_limit
        not_to: [unavailable, unknown]
<% else %>
      - trigger: time
        at: "00:01:00"
      - trigger: homeassistant
        event: start
      - trigger: time_pattern
        minutes: "/5"
<% endif %>
    conditions:
      - condition: state
        entity_id: input_boolean.<< s.id >>_gate
        state: "on"
      # Wait for the Nintendo integration (no errors while it's not set up yet)
      - condition: template
        value_template: "{{ states('<< s.entities.limit >>') not in ['unknown', 'unavailable'] }}"
    actions:
      - variables:
          num: << s.entities.limit >>
          allowed: "{{ states('sensor.<< s.id >>_play_limit') | int(0) }}"
<% if dry_run %>
      - action: logbook.log
        data:
          name: "<< s.name >> (dry run)"
          message: "would set the daily limit to {{ allowed }} min (now {{ states(num) }}) and turn on Suspend software"
          entity_id: sensor.<< s.id >>_play_limit
<% else %>
      - if:
          - condition: template
            value_template: "{{ states(num) | float(-99) | int != allowed }}"
        then:
          - action: number.set_value
            target:
              entity_id: "{{ num }}"
            data:
              value: "{{ allowed }}"
      - if:
          - condition: state
            entity_id: << s.entities.suspend >>
            state: "off"
        then:
          - action: switch.turn_on
            target:
              entity_id: << s.entities.suspend >>
<% endif %>

  - id: << uid >>_<< s.id >>_gate_release
    alias: "<< s.name >>: gate off = unlimited"
    triggers:
      - trigger: state
        entity_id: input_boolean.<< s.id >>_gate
        to: "off"
    conditions:
      - condition: template
        value_template: "{{ states('<< s.entities.limit >>') not in ['unknown', 'unavailable'] }}"
    actions:
<% if dry_run %>
      - action: logbook.log
        data:
          name: "<< s.name >> (dry run)"
          message: "would remove the daily limit and turn off Suspend software"
          entity_id: input_boolean.<< s.id >>_gate
<% else %>
      - action: number.set_value
        target:
          entity_id: << s.entities.limit >>
        data:
          value: -1
      - action: switch.turn_off
        target:
          entity_id: << s.entities.suspend >>
<% endif %>
<% else %>
<% if s.off_entity %>
  # Out of time while something counted is playing: << s.off_how >>
<% else %>
  # Out of time while something counted is playing: warn (no off switch configured for this screen).
  # Time past zero is logged in Bank History at the nightly rollover.
<% endif %>
  - id: << uid >>_<< s.id >>_gate_enforce
    alias: "<< s.name >>: << 'turn off' if s.off_entity else 'warn' >> when out of time"
    mode: single
    triggers:
      - trigger: state
        entity_id: binary_sensor.<< s.id >>_counted_playing
        to: "on"
      - trigger: numeric_state
        entity_id: sensor.<< s.id >>_minutes_left
        below: 1
<% if not dry_run and s.off_entity %>
      - trigger: time_pattern
        minutes: "/2"
<% endif %>
    conditions:
      - condition: state
        entity_id: input_boolean.<< s.id >>_gate
        state: "on"
      - condition: state
        entity_id: binary_sensor.<< s.id >>_counted_playing
        state: "on"
      - condition: numeric_state
        entity_id: sensor.<< s.id >>_minutes_left
        below: 1
    actions:
<% if dry_run %>
      - action: logbook.log
        data:
          name: "<< s.name >> (dry run)"
          message: "out of time: {{ states('sensor.<< s.id >>_active_app') }} is running; would << s.off_how if s.off_entity else 'warn that time is up' >>"
          entity_id: sensor.<< s.id >>_minutes_left
<% else %>
<% if s.off_entity %>
      # Skip quietly if the off switch's integration isn't set up yet
      - if:
          - condition: template
            value_template: "{{ states('<< s.off_entity >>') not in ['unknown', 'unavailable'] }}"
        then:
<% if s.type in ['apple_tv', 'xbox'] %>
          - action: media_player.media_pause
            target:
              entity_id: << s.entities.media_player >>
            continue_on_error: true
          - delay: "00:00:02"
<% endif %>
<% if s.type == 'apple_tv' %>
          - action: media_player.turn_off
            target:
              entity_id: << s.off_entity >>
<% elif s.type == 'xbox' %>
          - action: remote.turn_off
            target:
              entity_id: << s.off_entity >>
<% else %>
          - action: switch.turn_off
            target:
              entity_id: << s.off_entity >>
<% endif %>
<% endif %>
      - action: script.motivator_notify
        data:
          who: << s.earner_ids | tojson >>
          title: "<< s.name >> time's up"
          message: "Free time and the << s.name >> bank are both used up<% if not s.off_entity %>, so please stop playing. Extra time shows up in Bank History<% endif %>. Exercise or do a chore to earn more."
          view: home
<% endif %>

  - id: << uid >>_<< s.id >>_low_warning
    alias: "<< s.name >>: 15 minutes left"
    mode: queued
    triggers:
      - trigger: numeric_state
        entity_id: sensor.<< s.id >>_minutes_left
        below: 16
    conditions:
      - condition: state
        entity_id: input_boolean.<< s.id >>_gate
        state: "on"
      - condition: state
        entity_id: binary_sensor.<< s.id >>_counted_playing
        state: "on"
    actions:
      - action: script.motivator_notify
        data:
          who: << s.earner_ids | tojson >>
          title: "15 minutes of << s.name >> left"
          message: "Bank: {{ [states('sensor.<< s.id >>_available') | int(0), 0] | max }} min. Free time left: {{ states('sensor.<< s.id >>_free_left') }} min."
          view: home

<% if s.type == 'apple_tv' %>
  # Self-heal: reconnect if unavailable 3+ min, nightly at 4 AM, and 1 min after waking
  # (catches the integration reporting a stale app). Never sends on/off.
  - id: << uid >>_<< s.id >>_reconnect
    alias: "<< s.name >>: keep the connection fresh"
    mode: single
    max_exceeded: silent
    triggers:
      - trigger: time
        at: "04:00:00"
        id: nightly
      - trigger: state
        entity_id: << s.entities.media_player >>
        to: ["unavailable", "unknown"]
        for: "00:03:00"
        id: unavailable
      - trigger: state
        entity_id: << s.entities.media_player >>
        from: ["off", "standby"]
        to: ["on", "idle", "playing", "paused"]
        for: "00:01:00"
        id: wake
    actions:
      - action: script.<< s.id >>_reconnect
      - delay: "00:01:00"
<% endif %>
<% endif %>
