# Motivator: << p.name >> (<< p.role >>, << p.tracking >> tracking)
# GENERATED by build.py from household.yaml. Edit household.yaml and rebuild; don't edit this file.
#
# Earned today = exercise (<% if p.tracking == 'phone' %>Apple Health<% if p.work_hours %>, minus work hours<% endif %> + <% endif %>logged) + chores + steps.
# Earnings go to: <% for sid, pct in p.earn_to.items() %><< screens_by_id[sid].name >> << pct >>%<% if not loop.last %>, <% endif %><% endfor %>. Bonuses: << screens_by_id[p.bonus_to].name >>.

input_number:
  << p.id >>_exercise_manual_lifetime:
    name: "<< p.name >> logged exercise (lifetime)"
    icon: mdi:run
    min: 0
    max: 10000000
    step: 1
    mode: box
    unit_of_measurement: min
  << p.id >>_chores_lifetime:
    name: "<< p.name >> chores (lifetime)"
    icon: mdi:broom
    min: 0
    max: 10000000
    step: 1
    mode: box
    unit_of_measurement: min
  << p.id >>_active_days_week:
    name: "<< p.name >> active days this week"
    icon: mdi:calendar-check
    min: 0
    max: 7
    step: 1
    mode: box
  << p.id >>_tokens_used_week:
    name: "<< p.name >> tokens used this week"
    icon: mdi:ticket-confirmation
    min: 0
    max: 7
    step: 1
    mode: box
  << p.id >>_extra_tokens:
    name: "<< p.name >> extra tokens"
    icon: mdi:ticket
    min: 0
    max: 50
    step: 1
    mode: box
  << p.id >>_best_streak_weeks:
    name: "<< p.name >> best streak"
    icon: mdi:trophy-outline
    min: 0
    max: 1000
    step: 1
    mode: box

  # Weekly (use-it-or-lose-it) tokens used; extra tokens are separate and never expire
  << p.id >>_weekly_tokens_used:
    name: "<< p.name >> weekly tokens used"
    icon: mdi:ticket-outline
    min: 0
    max: 7
    step: 1
    mode: box

<% if p.work_hours %>
input_boolean:
  # Off (default) = Apple Health exercise during work hours doesn't count. On = it counts.
  << p.id >>_count_work_hours:
    name: "<< p.name >>: count exercise during work hours"
    icon: mdi:briefcase-clock-outline
<% endif %>

counter:
  << p.id >>_streak_weeks:
    name: "<< p.name >> streak (weeks)"
    icon: mdi:fire
    restore: true

utility_meter:
  << p.id >>_exercise_manual_daily:
    source: input_number.<< p.id >>_exercise_manual_lifetime
    cycle: daily
    periodically_resetting: false
    net_consumption: true
  << p.id >>_chores_daily:
    source: input_number.<< p.id >>_chores_lifetime
    cycle: daily
    periodically_resetting: false
    net_consumption: true
  << p.id >>_chores_week:
    source: input_number.<< p.id >>_chores_lifetime
    cron: "0 0 * * 0"
    periodically_resetting: false
    net_consumption: true
  << p.id >>_exercise_week:
    source: sensor.<< p.id >>_exercise_today
    cron: "0 0 * * 0"
    periodically_resetting: true
  << p.id >>_earned_week:
    source: sensor.<< p.id >>_earned_today
    cron: "0 0 * * 0"
    periodically_resetting: true
<% if p.tracking == 'phone' %>
  << p.id >>_steps_week:
    source: sensor.<< p.id >>_steps_today
    cron: "0 0 * * 0"
    periodically_resetting: true
<% endif %>

template:
<% if p.tracking == 'phone' %>
  # Steps today. The phone's Health sensor keeps yesterday's total until it sends a new one;
  # this reads 0 from midnight and copies the phone's value on each real update.
  - triggers:
      - trigger: time
        at: "00:00:00"
        id: reset
      - trigger: state
        entity_id: << p.health.steps >>
        not_to: [unavailable, unknown]
        id: update
      - trigger: event
        event_type: event_template_reloaded
        id: init
      - trigger: homeassistant
        event: start
        id: init
    sensor:
      - name: "<< p.name >> steps today"
        unique_id: << uid >>_<< p.id >>_steps_today
        default_entity_id: sensor.<< p.id >>_steps_today
        unit_of_measurement: steps
        state_class: total
        icon: mdi:shoe-print
        attributes:
          day: "{{ now().date() | string }}"
        state: >
          {% set src = '<< p.health.steps >>' %}
          {% set stale = this.attributes.get('day') is not none and this.attributes.get('day') != (now().date() | string) %}
          {% if trigger.id == 'reset' %}0
          {% elif trigger.id == 'update' and trigger.from_state is not none %}{{ states(src) | float(0) | int }}
          {% elif stale %}0
          {% elif trigger.id == 'init' and this.state in ['unknown', 'unavailable', None] %}{{ (states(src) | float(0) | int) if (states[src] is not none and as_local(states[src].last_changed).date() == now().date()) else 0 }}
          {% else %}{{ this.state if this.state not in ['unknown', 'unavailable', None] else 0 }}{% endif %}

  # Apple Health exercise minutes that count today. Works on the change between phone updates,
  # so a late batch is judged by when it arrives.
<% if p.work_hours %>
  # Minutes that arrive during work hours (<< p.work_hours.days | join(', ') >> << p.work_hours.start >>-<< p.work_hours.end >>)
  # are skipped unless input_boolean.<< p.id >>_count_work_hours is on.
<% endif %>
  - triggers:
      - trigger: time
        at: "00:00:00"
        id: reset
      - trigger: state
        entity_id: << p.health.exercise >>
        not_to: [unavailable, unknown]
        id: update
    sensor:
      - name: "<< p.name >> health exercise counted today"
        unique_id: << uid >>_<< p.id >>_exercise_counted_today
        default_entity_id: sensor.<< p.id >>_exercise_counted_today
        unit_of_measurement: min
        state_class: total
        icon: mdi:run-fast
        attributes:
          day: "{{ now().date() | string }}"
          excluded_work_minutes: >
            {% set stale = this.attributes.get('day') is not none and this.attributes.get('day') != (now().date() | string) %}
            {% set prev = 0 if stale else (this.attributes.get('excluded_work_minutes') | float(0)) %}
            {% if trigger.id == 'reset' %}0
            {% else %}
              {% set old = trigger.from_state.state if trigger.from_state is not none else 'x' %}
              {% set new = trigger.to_state.state | float(0) %}
              {% set d = 0 if not is_number(old) else ((new - old | float) if new >= old | float else new) %}
              {% set work = << work_expr(p) >> %}
              {{ (prev + (d if work else 0)) | round(0) | int }}
            {% endif %}
        state: >
          {% set stale = this.attributes.get('day') is not none and this.attributes.get('day') != (now().date() | string) %}
          {% set cur = 0 if stale or this.state in ['unknown', 'unavailable', None] else (this.state | float(0)) %}
          {% if trigger.id == 'reset' %}0
          {% else %}
            {% set old = trigger.from_state.state if trigger.from_state is not none else 'x' %}
            {% set new = trigger.to_state.state | float(0) %}
            {% set d = 0 if not is_number(old) else ((new - old | float) if new >= old | float else new) %}
            {% set work = << work_expr(p) >> %}
            {{ (cur + (0 if work else d)) | round(0) | int }}
          {% endif %}
<% endif %>

  - sensor:
      - name: "<< p.name >> exercise today"
        unique_id: << uid >>_<< p.id >>_exercise_today
        default_entity_id: sensor.<< p.id >>_exercise_today
        unit_of_measurement: min
        state_class: total
        icon: mdi:heart-flash
        state: >
          {{ (<% if p.tracking == 'phone' %>(states('sensor.<< p.id >>_exercise_counted_today') | float(0)) + <% endif %>(states('sensor.<< p.id >>_exercise_manual_daily') | float(0))) | round(0) | int }}

      - name: "<< p.name >> steps earned today"
        unique_id: << uid >>_<< p.id >>_steps_earned_today
        default_entity_id: sensor.<< p.id >>_steps_earned_today
        unit_of_measurement: min
        state_class: total
        icon: mdi:walk
        state: >
<% if p.tracking == 'phone' %>
          {{ ((states('sensor.<< p.id >>_steps_today') | float(0)) / << m.steps_per_minute >>) | int }}
<% else %>
          0
<% endif %>

      - name: "<< p.name >> earned today"
        unique_id: << uid >>_<< p.id >>_earned_today
        default_entity_id: sensor.<< p.id >>_earned_today
        unit_of_measurement: min
        state_class: total
        icon: mdi:account-heart
        state: >
          {{ ((states('sensor.<< p.id >>_exercise_today') | float(0)) +
              (states('sensor.<< p.id >>_chores_daily') | float(0)) +
              (states('sensor.<< p.id >>_steps_earned_today') | float(0))) | round(1) }}
        attributes:
          exercise: "{{ states('sensor.<< p.id >>_exercise_today') | int(0) }}"
          chores: "{{ states('sensor.<< p.id >>_chores_daily') | float(0) | int }}"
          steps_earned: "{{ states('sensor.<< p.id >>_steps_earned_today') | int(0) }}"
<% if p.tracking == 'phone' %>
          steps: "{{ states('sensor.<< p.id >>_steps_today') | int(0) }}"
<% endif %>

      # Active day = << m.active_day_minutes >>+ min of exercise and chores (steps don't count)
      - name: "<< p.name >> active minutes today"
        unique_id: << uid >>_<< p.id >>_active_minutes_today
        default_entity_id: sensor.<< p.id >>_active_minutes_today
        unit_of_measurement: min
        icon: mdi:account-check
        state: >
          {{ ((states('sensor.<< p.id >>_exercise_today') | float(0)) +
              (states('sensor.<< p.id >>_chores_daily') | float(0))) | int }}

      - name: "<< p.name >> week credits"
        unique_id: << uid >>_<< p.id >>_week_credits
        default_entity_id: sensor.<< p.id >>_week_credits
        icon: mdi:calendar-check
        state: >
          {{ (states('input_number.<< p.id >>_active_days_week') | int(0)) +
             (states('input_number.<< p.id >>_tokens_used_week') | int(0)) +
             (1 if states('sensor.<< p.id >>_active_minutes_today') | int(0) >= << m.active_day_minutes >> else 0) }}
        attributes:
          needed: << m.credits_per_week >>

      - name: "<< p.name >> tokens available"
        unique_id: << uid >>_<< p.id >>_tokens_available
        default_entity_id: sensor.<< p.id >>_tokens_available
        icon: mdi:ticket
        state: >
          {{ ([<< m.weekly_tokens >> - (states('input_number.<< p.id >>_weekly_tokens_used') | int(0)), 0] | max) +
             (states('input_number.<< p.id >>_extra_tokens') | int(0)) }}
