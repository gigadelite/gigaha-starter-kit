# Motivator: household-wide rules, logging, nightly rollover, weekly streaks, Chore Challenge
# GENERATED by build.py from household.yaml. Edit household.yaml and rebuild; don't edit this file.
#
# RULES (from household.yaml › motivator)
# - Exercise and chores earn 1:1. Steps earn 1 min per << m.steps_per_minute >> steps.
# - A day is "active" with << m.active_day_minutes >>+ min of your own exercise + chores (steps don't count).
# - A successful week = << m.credits_per_week >> credits (active days + tokens). << m.weekly_tokens >> free token(s)
#   per person per week (use it or lose it) plus any extra tokens won. Using a token needs a reason.
# - Streak bonuses go to each person's bonus screen: weeks 1-<< m.streak_bonus | length >> = << m.streak_bonus | join('/') >> min,
#   then << m.streak_bonus_after >> min a week and << m.streak_bonus_every_4th >> min every 4th week.
# - Weeks run Sunday-Saturday. 11:58 PM active days counted, 11:59 PM banks roll over,
#   Saturday 11:59:30 PM streaks settled, Sunday 12:00 AM new week, Sunday noon Chore Challenge + recap.
#
# Needs three Local Calendars (Settings > Devices & services > Add > Local Calendar):
#   "Exercise Log", "Chore Log", "Bank History". Everything still works without them; you just lose the log.

input_boolean:
  motivator_defaults_applied:
    name: Motivator defaults applied
    icon: mdi:check-decagram

input_datetime:
  motivator_last_rollover:
    name: Last bank rollover
    icon: mdi:calendar-check
    has_date: true
    has_time: true
  motivator_extra_date:
    name: Extra time date
    icon: mdi:calendar-plus
    has_date: true
    has_time: false

input_select:
  motivator_who:
    name: Who
    icon: mdi:account
    options:
<% for p in people %>
      - "<< p.name >>"
<% endfor %>
  motivator_exercise_type:
    name: Activity
    icon: mdi:run-fast
    options:
<% for e in exercise_types %>
      - "<< e >>"
<% endfor %>
  motivator_chore:
    name: Chore
    icon: mdi:broom
    options:
      - "Pick a chore"
<% for c in chores %>
      - "<< c.name >>"
<% endfor %>
  motivator_quick_screen:
    name: Screen
    icon: mdi:monitor
    options:
<% for s in screens %>
      - "<< s.name >>"
<% endfor %>

input_number:
  motivator_exercise_minutes:
    name: Minutes
    icon: mdi:timer-outline
    min: 0
    max: 300
    step: 5
    mode: box
    unit_of_measurement: min
  motivator_chore_minutes:
    name: Minutes
    icon: mdi:timer-outline
    min: 0
    max: 300
    step: 5
    mode: box
    unit_of_measurement: min
  motivator_quick_minutes:
    name: Minutes to add or remove
    icon: mdi:timer-plus-outline
    min: 5
    max: 120
    step: 5
    mode: slider
    unit_of_measurement: min

input_text:
  motivator_note:
    name: Note (optional)
    icon: mdi:note-text-outline
    max: 100
  motivator_token_reason:
    name: Reason
    icon: mdi:note-text-outline
    max: 100
  motivator_last_entry:
    name: Last logged entry
    max: 255
  motivator_chore_owed:
    name: Chore owed
    icon: mdi:broom
    max: 200
<% for p in people %>
  << p.id >>_last_week:
    name: "<< p.name >> last week"
    icon: mdi:calendar-week
    max: 255
<% endfor %>

template:
  - binary_sensor:
      - name: Motivator dry run
        unique_id: << uid >>_motivator_dry_run
        default_entity_id: binary_sensor.motivator_dry_run
        icon: mdi:test-tube
        state: "<< 'on' if dry_run else 'off' >>"

  - sensor:
      - name: Household earned today
        unique_id: << uid >>_household_earned_today
        default_entity_id: sensor.household_earned_today
        unit_of_measurement: min
        state_class: total
        icon: mdi:home-heart
        state: >
          {{ (0<% for p in people %> + (states('sensor.<< p.id >>_earned_today') | float(0))<% endfor %>) | round(0) | int }}

      - name: Chore owed display
        unique_id: << uid >>_chore_owed_display
        default_entity_id: sensor.motivator_chore_owed
        icon: mdi:broom
        state: >
          {% set s = states('input_text.motivator_chore_owed') %}
          {{ 'None' if s in ['', 'unknown', 'unavailable'] else s[:250] }}
<% if challenge %>

      # Chore Challenge standings this week (chore minutes only)
      - name: Chore Challenge leader
        unique_id: << uid >>_challenge_leader
        default_entity_id: sensor.chore_challenge_leader
        icon: mdi:trophy
        state: >
          {% set rows = [<% for p in people %>{'name': '<< p.name | replace("'", "\\'") >>', 'min': states('sensor.<< p.id >>_chores_week') | float(0)}<% if not loop.last %>, <% endif %><% endfor %>] %}
          {% set top = rows | map(attribute='min') | max %}
          {% set leaders = rows | selectattr('min', 'eq', top) | map(attribute='name') | list %}
          {{ 'No chores yet' if top == 0 else ('Tied' if leaders | count > 1 else leaders[0]) }}
        attributes:
          standings: >
            {% set rows = [<% for p in people %>{'id': '<< p.id >>', 'name': '<< p.name | replace("'", "\\'") >>', 'min': states('sensor.<< p.id >>_chores_week') | float(0) | int, 'last_week': state_attr('sensor.<< p.id >>_chores_week', 'last_period') | float(0) | int}<% if not loop.last %>, <% endif %><% endfor %>] %}
            {{ rows | sort(attribute='min', reverse=true) | list }}
<% endif %>

  # Bank history, last 7 days, for the dashboard (the calendar keeps the full record)
  - triggers:
      - trigger: homeassistant
        event: start
      - trigger: event
        event_type: event_template_reloaded
      - trigger: event
        event_type: motivator_bank_history_written
      - trigger: time
        at: "00:00:30"
      - trigger: time_pattern
        minutes: "/10"
    actions:
      - condition: template
        value_template: "{{ states('calendar.bank_history') not in ['unknown', 'unavailable'] }}"
      - action: calendar.get_events
        target:
          entity_id: calendar.bank_history
        data:
          start_date_time: "{{ (today_at() - timedelta(days=7)).isoformat() }}"
          end_date_time: "{{ (today_at() + timedelta(days=1)).isoformat() }}"
        response_variable: bank_cal
        continue_on_error: true
    sensor:
      - name: Bank history recent
        unique_id: << uid >>_bank_history_recent
        default_entity_id: sensor.bank_history_recent
        icon: mdi:history
        state: "{{ (bank_cal if bank_cal is defined else {}).get('calendar.bank_history', {}).get('events', []) | count }}"
        attributes:
          events: >
            {% set ev = (bank_cal if bank_cal is defined else {}).get('calendar.bank_history', {}).get('events', []) %}
            {% set ns = namespace(out=[]) %}
            {% for e in ev %}{% set ns.out = ns.out + [{'date': e.start[:10], 'summary': e.summary}] %}{% endfor %}
            {{ (ns.out | sort(attribute='date'))[::-1][:20] }}

script:
  # Writes a log entry to one of the Local Calendars, and quietly skips it if that calendar
  # hasn't been created yet (so a missing calendar never stops an automation).
  motivator_calendar_event:
    alias: Motivator calendar entry
    icon: mdi:calendar-plus
    mode: queued
    max: 50
    fields:
      calendar:
        description: calendar entity (calendar.exercise_log, calendar.chore_log, calendar.bank_history)
      summary:
        description: Title
      description:
        description: Optional details
      start_date:
        description: All-day start (with end_date)
      end_date:
        description: All-day end
      start_date_time:
        description: Timed start (with end_date_time)
      end_date_time:
        description: Timed end
    sequence:
      - condition: template
        value_template: "{{ states(calendar) not in ['unknown', 'unavailable'] }}"
      - action: calendar.create_event
        continue_on_error: true
        target:
          entity_id: "{{ calendar }}"
        data: >
          {% set d = {'summary': summary} %}
          {% if description is defined and description %}{% set d = dict(d, description=description) %}{% endif %}
          {% if start_date_time is defined and start_date_time %}{% set d = dict(d, start_date_time=start_date_time, end_date_time=end_date_time) %}
          {% else %}{% set d = dict(d, start_date=start_date | string, end_date=end_date | string) %}{% endif %}
          {{ d }}
      - if: "{{ calendar == 'calendar.bank_history' }}"
        then:
          - event: motivator_bank_history_written

  # One place that decides where notifications go.
  #   who: a person id, a list of ids, or "all"
  #   view: home (that person's Motivator page), log, or settings
  # People without a phone, and children set to notify_parents, route to the admins' phones too.
  motivator_notify:
    alias: Motivator notify
    icon: mdi:bell-ring
    mode: parallel
    fields:
      who:
        description: Person id, list of ids, or "all"
        example: all
      title:
        description: Title
      message:
        description: Message
      view:
        description: home, log or settings
        example: home
      actions:
        description: Optional actionable-notification buttons
      tag:
        description: Optional notification tag
    sequence:
      - variables:
          routes: << routes | tojson >>
          ids: >
            {% if who is not defined or who in ['all', '', none] %}{{ routes.keys() | list }}
            {% elif who is string %}{{ [who] }}
            {% else %}{{ who | list }}{% endif %}
          targets: >
            {% set ns = namespace(seen=[], out=[]) %}
            {% for pid in ids %}{% for svc in routes.get(pid, []) %}
              {% if svc not in ns.seen %}{% set ns.seen = ns.seen + [svc] %}{% set ns.out = ns.out + [{'svc': svc, 'pid': pid}] %}{% endif %}
            {% endfor %}{% endfor %}
            {{ ns.out }}
      # Each phone gets its own run of motivator_notify_one, so a phone that isn't set up yet
      # can't stop the others (or the automation that called this).
      - repeat:
          for_each: "{{ targets }}"
          sequence:
            - action: script.turn_on
              target:
                entity_id: script.motivator_notify_one
              data:
                variables:
                  svc: "{{ repeat.item.svc }}"
                  url: >
                    {% set v = view | default('home', true) %}
                    {{ '/log-activity/log' if v == 'log' else ('/motivator-settings/settings' if v == 'settings' else '/the-motivator/' ~ repeat.item.pid) }}
                  title: "{{ title }}"
                  message: "{{ message }}"
                  tag: "{{ tag | default('', true) }}"
                  actions: "{{ actions | default([], true) }}"

  motivator_notify_one:
    alias: Motivator notify (one phone)
    icon: mdi:cellphone-message
    mode: parallel
    max: 50
    fields:
      svc:
        description: notify action, e.g. notify.mobile_app_<phone>
    sequence:
      # Skip phones whose companion app isn't registered yet
      - condition: template
        value_template: >
          {% set phone = svc.replace('notify.mobile_app_', '') %}
          {{ integration_entities('mobile_app') | select('search', phone) | list | count > 0 }}
      - action: "{{ svc }}"
        continue_on_error: true
        data:
          title: "{{ title }}"
          message: "{{ message }}"
          data: >
            {% set d = {'url': url} %}
            {% if tag %}{% set d = dict(d, tag=tag) %}{% endif %}
            {% if actions %}{% set d = dict(d, actions=actions) %}{% endif %}
            {{ d }}

  # ---------------- Logging ----------------
  motivator_log_exercise:
    alias: Log exercise
    icon: mdi:run
    mode: queued
    sequence:
      - variables:
          ids: << name_to_id | tojson >>
          who: "{{ states('input_select.motivator_who') }}"
          pid: "{{ ids.get(who, '') }}"
          activity: "{{ states('input_select.motivator_exercise_type') }}"
          mins: "{{ states('input_number.motivator_exercise_minutes') | int(0) }}"
          note: "{{ states('input_text.motivator_note') }}"
          counter: "input_number.{{ pid }}_exercise_manual_lifetime"
      - condition: template
        value_template: "{{ pid != '' and mins > 0 }}"
      - action: input_number.set_value
        target:
          entity_id: "{{ counter }}"
        data:
          value: "{{ states(counter) | float(0) + mins }}"
      - action: script.motivator_calendar_event
        data:
          calendar: calendar.exercise_log
          summary: "{{ who }}: {{ activity }}{{ ' - ' ~ note if note not in ['', 'unknown', 'unavailable'] else '' }} ({{ mins }} min)"
          start_date_time: "{{ (now() - timedelta(minutes=mins)).strftime('%Y-%m-%d %H:%M:%S') }}"
          end_date_time: "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"
      - action: input_text.set_value
        target:
          entity_id: input_text.motivator_last_entry
        data:
          value: "exercise|{{ pid }}|{{ who }}: {{ activity }}|{{ mins }}"
      - action: input_text.set_value
        target:
          entity_id: input_text.motivator_note
        data:
          value: ""
      - action: input_number.set_value
        target:
          entity_id: input_number.motivator_exercise_minutes
        data:
          value: 0

  motivator_log_chore:
    alias: Log chore
    icon: mdi:broom
    mode: queued
    fields:
      who_id:
        description: Optional person id (used by to-do/task automations); defaults to the Who picker
      chore:
        description: Optional chore name; defaults to the Chore picker
      minutes:
        description: Optional minutes; defaults to the Minutes box
    sequence:
      - variables:
          ids: << name_to_id | tojson >>
          names: << id_to_name | tojson >>
          pid: "{{ who_id if who_id is defined and who_id in names else ids.get(states('input_select.motivator_who'), '') }}"
          who: "{{ names.get(pid, '') }}"
          what: "{{ chore if chore is defined and chore else states('input_select.motivator_chore') }}"
          mins: "{{ (minutes if minutes is defined else states('input_number.motivator_chore_minutes')) | int(0) }}"
          note: "{{ states('input_text.motivator_note') }}"
          counter: "input_number.{{ pid }}_chores_lifetime"
      - condition: template
        value_template: "{{ pid != '' and mins > 0 and what != 'Pick a chore' }}"
      - action: input_number.set_value
        target:
          entity_id: "{{ counter }}"
        data:
          value: "{{ states(counter) | float(0) + mins }}"
      - action: script.motivator_calendar_event
        data:
          calendar: calendar.chore_log
          summary: "{{ who }}: {{ what }}{{ ' - ' ~ note if note not in ['', 'unknown', 'unavailable'] else '' }} ({{ mins }} min)"
          start_date_time: "{{ (now() - timedelta(minutes=mins)).strftime('%Y-%m-%d %H:%M:%S') }}"
          end_date_time: "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"
      - action: input_text.set_value
        target:
          entity_id: input_text.motivator_last_entry
        data:
          value: "chores|{{ pid }}|{{ who }}: {{ what }}|{{ mins }}"
      - action: input_text.set_value
        target:
          entity_id: input_text.motivator_note
        data:
          value: ""
      - action: input_number.set_value
        target:
          entity_id: input_number.motivator_chore_minutes
        data:
          value: 0
      - action: input_select.select_option
        target:
          entity_id: input_select.motivator_chore
        data:
          option: "Pick a chore"

  motivator_undo_last:
    alias: Undo last entry
    icon: mdi:undo
    mode: single
    sequence:
      - variables:
          parts: "{{ states('input_text.motivator_last_entry').split('|') }}"
      - if:
          - condition: template
            value_template: "{{ parts | count != 4 }}"
        then:
          - action: persistent_notification.create
            data:
              title: Nothing to undo
              message: There's no recent entry to undo.
              notification_id: motivator_undo
          - stop: Nothing to undo
      - variables:
          kind: "{{ parts[0] }}"
          pid: "{{ parts[1] }}"
          label: "{{ parts[2] }}"
          mins: "{{ parts[3] | int(0) }}"
          counter: "input_number.{{ pid }}_{{ 'exercise_manual' if kind == 'exercise' else 'chores' }}_lifetime"
      - action: input_number.set_value
        target:
          entity_id: "{{ counter }}"
        data:
          value: "{{ [states(counter) | float(0) - mins, 0] | max }}"
      - action: script.motivator_calendar_event
        data:
          calendar: "{{ 'calendar.exercise_log' if kind == 'exercise' else 'calendar.chore_log' }}"
          summary: "UNDONE - {{ label }} (-{{ mins }} min)"
          start_date_time: "{{ (now() - timedelta(minutes=1)).strftime('%Y-%m-%d %H:%M:%S') }}"
          end_date_time: "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"
      - action: input_text.set_value
        target:
          entity_id: input_text.motivator_last_entry
        data:
          value: ""
      - action: persistent_notification.create
        data:
          title: Entry undone
          message: "Removed {{ label }} ({{ mins }} min)."
          notification_id: motivator_undo

  motivator_use_token:
    alias: Use a token
    icon: mdi:ticket
    mode: single
    sequence:
      - variables:
          ids: << name_to_id | tojson >>
          who: "{{ states('input_select.motivator_who') }}"
          pid: "{{ ids.get(who, '') }}"
          reason: "{{ states('input_text.motivator_token_reason') | trim }}"
          weekly_left: "{{ [<< m.weekly_tokens >> - (states('input_number.' ~ pid ~ '_weekly_tokens_used') | int(0)), 0] | max }}"
          extra: "{{ states('input_number.' ~ pid ~ '_extra_tokens') | int(0) }}"
          credits: "{{ states('sensor.' ~ pid ~ '_week_credits') | int(0) }}"
          problem: >
            {% if pid == '' %}Pick who first.
            {% elif reason in ['', 'unknown', 'unavailable'] %}Add a quick reason first.
            {% elif credits >= << m.credits_per_week >> %}{{ who }} already has {{ credits }} of << m.credits_per_week >> this week. Token saved.
            {% elif weekly_left < 1 and extra < 1 %}{{ who }} has no tokens left this week.
            {% endif %}
      - if:
          - condition: template
            value_template: "{{ problem | trim != '' }}"
        then:
          - action: persistent_notification.create
            data:
              title: Token not used
              message: "{{ problem | trim }}"
              notification_id: motivator_token
          - stop: "{{ problem | trim }}"
      - action: input_number.set_value
        target:
          entity_id: "input_number.{{ pid }}_{{ 'weekly_tokens_used' if weekly_left > 0 else 'extra_tokens' }}"
        data:
          value: >
            {{ (states('input_number.' ~ pid ~ '_weekly_tokens_used') | int(0) + 1) if weekly_left > 0 else (extra - 1) }}
      - action: input_number.set_value
        target:
          entity_id: "input_number.{{ pid }}_tokens_used_week"
        data:
          value: "{{ states('input_number.' ~ pid ~ '_tokens_used_week') | int(0) + 1 }}"
      - action: script.motivator_calendar_event
        data:
          calendar: calendar.exercise_log
          summary: "Token - {{ who }}: {{ reason }}"
          start_date: "{{ now().date() }}"
          end_date: "{{ (now() + timedelta(days=1)).date() }}"
      - action: input_text.set_value
        target:
          entity_id: input_text.motivator_token_reason
        data:
          value: ""

  motivator_clear_chore_owed:
    alias: Chore owed is done
    icon: mdi:check
    sequence:
      - action: input_text.set_value
        target:
          entity_id: input_text.motivator_chore_owed
        data:
          value: ""

  # ---------------- Admin: quick add / remove / reset ----------------
  # Add: goes on top of the chosen screen's free time for today only (never banked)
  motivator_quick_add:
    alias: Add time today
    icon: mdi:timer-plus-outline
    mode: queued
    sequence:
      - variables:
          screens: << screen_name_to_id | tojson >>
          name: "{{ states('input_select.motivator_quick_screen') }}"
          sid: "{{ screens.get(name, '') }}"
          mins: "{{ states('input_number.motivator_quick_minutes') | int(0) }}"
          target: "input_number.{{ sid }}_extra_today"
      - condition: template
        value_template: "{{ sid != '' and mins > 0 }}"
      - action: input_number.set_value
        target:
          entity_id: "{{ target }}"
        data:
          value: "{{ states(target) | int(0) + mins }}"
      - action: input_datetime.set_datetime
        target:
          entity_id: input_datetime.motivator_extra_date
        data:
          date: "{{ now().date() }}"
      - action: script.motivator_calendar_event
        data:
          calendar: calendar.bank_history
          summary: "+{{ mins }} min {{ name }} (added by hand)"
          start_date: "{{ now().date() }}"
          end_date: "{{ (now() + timedelta(days=1)).date() }}"

  # Remove: from today's extra first, then the regular bank, then the bonus bank. Never below 0.
  motivator_quick_remove:
    alias: Remove time
    icon: mdi:timer-minus-outline
    mode: queued
    sequence:
      - variables:
          screens: << screen_name_to_id | tojson >>
          name: "{{ states('input_select.motivator_quick_screen') }}"
          sid: "{{ screens.get(name, '') }}"
          mins: "{{ states('input_number.motivator_quick_minutes') | int(0) }}"
          extra: "{{ states('input_number.' ~ sid ~ '_extra_today') | int(0) }}"
          reg: "{{ states('input_number.' ~ sid ~ '_bank') | int(0) }}"
          bonus: "{{ states('input_number.' ~ sid ~ '_bonus_bank') | int(0) }}"
          from_extra: "{{ [mins, extra] | min }}"
          from_reg: "{{ [mins - from_extra, reg] | min }}"
          from_bonus: "{{ [mins - from_extra - from_reg, bonus] | min }}"
      - condition: template
        value_template: "{{ sid != '' and mins > 0 }}"
      - action: input_number.set_value
        target: {entity_id: "input_number.{{ sid }}_extra_today"}
        data: {value: "{{ extra - from_extra }}"}
      - action: input_number.set_value
        target: {entity_id: "input_number.{{ sid }}_bank"}
        data: {value: "{{ reg - from_reg }}"}
      - action: input_number.set_value
        target: {entity_id: "input_number.{{ sid }}_bonus_bank"}
        data: {value: "{{ bonus - from_bonus }}"}
      - action: script.motivator_calendar_event
        data:
          calendar: calendar.bank_history
          summary: "-{{ from_extra + from_reg + from_bonus }} min {{ name }} (removed by hand)"
          description: "Extra today {{ from_extra }}, regular {{ from_reg }}, bonus {{ from_bonus }}."
          start_date: "{{ now().date() }}"
          end_date: "{{ (now() + timedelta(days=1)).date() }}"

  motivator_reset_banks:
    alias: Reset all banks to zero
    icon: mdi:piggy-bank-outline
    mode: single
    sequence:
      - action: input_number.set_value
        target:
          entity_id:
<% for s in screens %>
            - input_number.<< s.id >>_bank
            - input_number.<< s.id >>_bonus_bank
<% endfor %>
        data:
          value: 0
      - action: script.motivator_calendar_event
        data:
          calendar: calendar.bank_history
          summary: "All banks reset to 0 (by hand)"
          start_date: "{{ now().date() }}"
          end_date: "{{ (now() + timedelta(days=1)).date() }}"

automation:
  # First start: apply the defaults from household.yaml once (after that, the Settings dashboard owns them)
  - id: << uid >>_motivator_seed_defaults
    alias: "Motivator: apply household.yaml defaults (once)"
    mode: single
    triggers:
      - trigger: homeassistant
        event: start
      - trigger: event
        event_type: automation_reloaded
    conditions:
      - condition: state
        entity_id: input_boolean.motivator_defaults_applied
        state: "off"
    actions:
      - delay: "00:00:15"
<% for s in screens %>
      - action: input_number.set_value
        target: {entity_id: input_number.<< s.id >>_free_minutes}
        data: {value: << s.free_minutes >>}
      - action: input_number.set_value
        target: {entity_id: input_number.<< s.id >>_bank_cap}
        data: {value: << s.bank_cap >>}
      - action: input_boolean.turn_<< 'on' if s.free_minutes > 0 else 'off' >>
        target: {entity_id: input_boolean.<< s.id >>_free_enabled}
      - action: input_boolean.turn_on
        target: {entity_id: input_boolean.<< s.id >>_gate}
<% endfor %>
      - action: input_boolean.turn_on
        target: {entity_id: input_boolean.motivator_defaults_applied}

  # Fill the chore's default minutes when one is picked
  - id: << uid >>_motivator_chore_defaults
    alias: "Motivator: fill a chore's default minutes"
    mode: restart
    triggers:
      - trigger: state
        entity_id: input_select.motivator_chore
    actions:
      - variables:
          defaults: << chore_defaults | tojson >>
      - action: input_number.set_value
        target:
          entity_id: input_number.motivator_chore_minutes
        data:
          value: "{{ defaults.get(states('input_select.motivator_chore'), 0) }}"

  # 11:58 PM: count today as an active day for each person with enough minutes
  - id: << uid >>_motivator_active_days
    alias: "Motivator: count active days"
    triggers:
      - trigger: time
        at: "23:58:00"
    actions:
      - repeat:
          for_each: << people_ids | tojson >>
          sequence:
            - if:
                - condition: template
                  value_template: "{{ states('sensor.' ~ repeat.item ~ '_active_minutes_today') | int(0) >= << m.active_day_minutes >> }}"
              then:
                - action: input_number.set_value
                  target:
                    entity_id: "input_number.{{ repeat.item }}_active_days_week"
                  data:
                    value: "{{ states('input_number.' ~ repeat.item ~ '_active_days_week') | int(0) + 1 }}"

  # 11:59 PM: per screen, what's left is kept as bonus first (uncapped), the rest as regular up to the cap
  - id: << uid >>_motivator_rollover
    alias: "Motivator: nightly bank rollover"
    mode: single
    triggers:
      - trigger: time
        at: "23:59:00"
    actions:
<% for s in screens %>
      - variables:
          cap: "{{ states('input_number.<< s.id >>_bank_cap') | float(<< s.bank_cap >>) }}"
          was: "{{ (states('input_number.<< s.id >>_bank') | int(0)) + (states('input_number.<< s.id >>_bonus_bank') | int(0)) }}"
          raw: "{{ states('sensor.<< s.id >>_available') | float(0) }}"
          left: "{{ [raw, 0] | max }}"
          new_bonus: "{{ [states('input_number.<< s.id >>_bonus_bank') | float(0), left] | min | int }}"
          new_reg: "{{ [[left - new_bonus, 0] | max, cap] | min | int }}"
          earned: "{{ states('sensor.<< s.id >>_earned_today') | float(0) | round(0) | int }}"
          spent: "{{ states('sensor.<< s.id >>_over_allotment') | int(0) }}"
          gated: "{{ is_state('input_boolean.<< s.id >>_gate', 'on') }}"
      - if:
          - condition: template
            value_template: "{{ gated }}"
        then:
          - action: input_number.set_value
            target: {entity_id: input_number.<< s.id >>_bank}
            data: {value: "{{ new_reg }}"}
          - action: input_number.set_value
            target: {entity_id: input_number.<< s.id >>_bonus_bank}
            data: {value: "{{ new_bonus }}"}
          - action: script.motivator_calendar_event
            data:
              calendar: calendar.bank_history
              summary: "<< s.name >> {{ was }} → {{ new_reg + new_bonus }} min"
              description: >-
                Earned +{{ earned }}, spent past free time {{ spent }}.
                Closing {{ new_reg }} regular{{ ' + ' ~ new_bonus ~ ' bonus' if new_bonus > 0 else '' }}{{ ' (cap ' ~ cap | int ~ ')' if left - new_bonus > cap else '' }}.{{ ' Went ' ~ (0 - raw) | int ~ ' min over.' if raw < 0 else '' }}
              start_date: "{{ now().date() }}"
              end_date: "{{ (now() + timedelta(days=1)).date() }}"
<% endfor %>
      - action: input_datetime.set_datetime
        target:
          entity_id: input_datetime.motivator_last_rollover
        data:
          datetime: "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"

  # If HA was down at 11:59 PM, that day's earned/spent minutes can't be replayed. Flag it.
  - id: << uid >>_motivator_missed_rollover
    alias: "Motivator: flag a missed rollover"
    mode: single
    triggers:
      - trigger: homeassistant
        event: start
    actions:
      - delay: "00:02:00"
      - variables:
          last: "{{ states('input_datetime.motivator_last_rollover') }}"
          yesterday: "{{ (now() - timedelta(days=1)).date() | string }}"
      - condition: template
        value_template: "{{ last not in ['unknown', 'unavailable', ''] and not last.startswith('1970') and last[:10] < yesterday }}"
      - action: script.motivator_calendar_event
        data:
          calendar: calendar.bank_history
          summary: "Rollover missed ({{ yesterday }})"
          description: "Home Assistant was down at 11:59 PM. Banks carried over unchanged."
          start_date: "{{ yesterday }}"
          end_date: "{{ now().date() }}"
      - action: script.motivator_notify
        data:
          who: << admin_ids | tojson >>
          title: Bank rollover missed
          message: "Home Assistant was down at 11:59 PM on {{ yesterday }}, so that day's minutes weren't applied. Banks carried over unchanged."
          view: settings

  # Quick-add extras last one day
  - id: << uid >>_motivator_extra_reset
    alias: "Motivator: clear today's extra time at midnight"
    mode: single
    triggers:
      - trigger: time
        at: "00:00:00"
      - trigger: homeassistant
        event: start
    conditions:
      - condition: template
        value_template: "{{ states('input_datetime.motivator_extra_date') != (now().date() | string) }}"
    actions:
      - action: input_number.set_value
        target:
          entity_id:
<% for s in screens %>
            - input_number.<< s.id >>_extra_today
<% endfor %>
        data:
          value: 0

  # Saturday 11:59:30 PM (after the rollover): settle streaks and bonuses quietly; the recap sends them Sunday
  - id: << uid >>_motivator_streaks
    alias: "Motivator: weekly streaks and bonuses"
    triggers:
      - trigger: time
        at: "23:59:30"
    conditions:
      - condition: time
        weekday: [sat]
    actions:
      - repeat:
          for_each: << streak_items | tojson >>
          sequence:
            - variables:
                p: "{{ repeat.item.p }}"
                credits: "{{ (states('input_number.' ~ p ~ '_active_days_week') | int(0)) + (states('input_number.' ~ p ~ '_tokens_used_week') | int(0)) }}"
                earned: "{{ states('sensor.' ~ p ~ '_earned_week') | float(0) | int }}"
            - if:
                - condition: template
                  value_template: "{{ credits >= << m.credits_per_week >> }}"
              then:
                - action: counter.increment
                  target:
                    entity_id: "counter.{{ p }}_streak_weeks"
                - variables:
                    n: "{{ states('counter.' ~ p ~ '_streak_weeks') | int(0) }}"
                    table: << m.streak_bonus | tojson >>
                    bonus: "{{ table[n - 1] if n <= table | count else (<< m.streak_bonus_every_4th >> if n % 4 == 0 else << m.streak_bonus_after >>) }}"
                - action: input_number.set_value
                  target:
                    entity_id: "input_number.{{ repeat.item.screen }}_bonus_bank"
                  data:
                    value: "{{ states('input_number.' ~ repeat.item.screen ~ '_bonus_bank') | float(0) + bonus }}"
                - if:
                    - condition: template
                      value_template: "{{ n > states('input_number.' ~ p ~ '_best_streak_weeks') | int(0) }}"
                  then:
                    - action: input_number.set_value
                      target:
                        entity_id: "input_number.{{ p }}_best_streak_weeks"
                      data:
                        value: "{{ n }}"
                - action: script.motivator_calendar_event
                  data:
                    calendar: calendar.bank_history
                    summary: "Streak bonus - {{ repeat.item.name }}: week {{ n }}, +{{ bonus }} min {{ repeat.item.screen_name }}"
                    start_date: "{{ now().date() }}"
                    end_date: "{{ (now() + timedelta(days=1)).date() }}"
                - action: input_text.set_value
                  target:
                    entity_id: "input_text.{{ p }}_last_week"
                  data:
                    value: "{{ credits }}/<< m.credits_per_week >> days, {{ n }}-week streak, +{{ bonus }} min {{ repeat.item.screen_name }} bonus. Earned {{ earned }} min."
              else:
                - action: counter.reset
                  target:
                    entity_id: "counter.{{ p }}_streak_weeks"
                - action: input_text.set_value
                  target:
                    entity_id: "input_text.{{ p }}_last_week"
                  data:
                    value: "{{ credits }}/<< m.credits_per_week >> days, streak reset. Earned {{ earned }} min."

  # Sunday 12:01 AM: new week
  - id: << uid >>_motivator_new_week
    alias: "Motivator: new week"
    triggers:
      - trigger: time
        at: "00:01:00"
    conditions:
      - condition: time
        weekday: [sun]
    actions:
      - action: input_number.set_value
        target:
          entity_id:
<% for p in people %>
            - input_number.<< p.id >>_active_days_week
            - input_number.<< p.id >>_tokens_used_week
            - input_number.<< p.id >>_weekly_tokens_used
<% endfor %>
        data:
          value: 0
<% if challenge %>

  # Sunday noon: crown last week's Chore Challenge Champion; they pick a prize from their phone
  - id: << uid >>_motivator_challenge
    alias: "Motivator: Chore Challenge"
    mode: single
    triggers:
      - trigger: time
        at: "12:00:00"
    conditions:
      - condition: time
        weekday: [sun]
    actions:
      - variables:
          rows: >
            [<% for p in people %>{"id": "<< p.id >>", "name": << p.name | tojson >>, "screen": "<< p.bonus_to >>", "screen_name": << screens_by_id[p.bonus_to].name | tojson >>, "min": {{ state_attr('sensor.<< p.id >>_chores_week', 'last_period') | float(0) | int }}}<% if not loop.last %>, <% endif %><% endfor %>]
          top: "{{ rows | map(attribute='min') | max }}"
          bottom: "{{ rows | map(attribute='min') | min }}"
          leaders: "{{ rows | selectattr('min', 'eq', top) | list }}"
          losers: "{{ rows | selectattr('min', 'eq', bottom) | list }}"
          standings: >-
            {% for r in rows | sort(attribute='min', reverse=true) %}{{ r.name }} {{ r.min }} min{{ ', ' if not loop.last else '' }}{% endfor %}
      - if:
          - condition: template
            value_template: "{{ top == 0 or leaders | count > 1 }}"
        then:
          - action: script.motivator_notify
            data:
              who: all
              title: "Chore Challenge: {{ 'no chores logged' if top == 0 else 'tie' }}"
              message: "{{ standings }}. No champion this week."
          - stop: No single winner
      - variables:
          w: "{{ leaders[0] }}"
          loser_names: "{{ losers | map(attribute='name') | join(' and ') }}"
          tag: "motivator-challenge-{{ now().date() }}"
      - action: script.motivator_notify
        data:
          who: "{{ w.id }}"
          title: "🏆 {{ w.name }} is the Chore Challenge Champion!"
          message: "{{ standings }}. Pick a prize (the bonus is applied after << m.challenge_pick_hours >> hours)."
          tag: "{{ tag }}"
          actions:
            - action: MOTIVATOR_PRIZE_BONUS
              title: "<< m.challenge_prize_minutes >> min {{ w.screen_name }} bonus"
            - action: MOTIVATOR_PRIZE_CHORE
              title: "{{ loser_names }} does a chore"
            - action: MOTIVATOR_PRIZE_TOKEN
              title: "Extra token"
      - wait_for_trigger:
          - trigger: event
            event_type: mobile_app_notification_action
            event_data:
              action: MOTIVATOR_PRIZE_BONUS
            id: bonus
          - trigger: event
            event_type: mobile_app_notification_action
            event_data:
              action: MOTIVATOR_PRIZE_CHORE
            id: chore
          - trigger: event
            event_type: mobile_app_notification_action
            event_data:
              action: MOTIVATOR_PRIZE_TOKEN
            id: token
        timeout: "<< '%02d' | format(m.challenge_pick_hours) >>:00:00"
        continue_on_timeout: true
      - variables:
          prize: "{{ wait.trigger.id if wait.trigger else 'bonus' }}"
      - choose:
          - conditions: "{{ prize == 'chore' }}"
            sequence:
              - action: input_text.set_value
                target:
                  entity_id: input_text.motivator_chore_owed
                data:
                  value: "{{ loser_names }} owe{{ '' if losers | count > 1 else 's' }} {{ w.name }} a chore (winner's choice)"
              - action: script.motivator_notify
                data:
                  who: "{{ losers | map(attribute='id') | list }}"
                  title: "You owe {{ w.name }} a chore"
                  message: "{{ w.name }} won the Chore Challenge and picks a chore for you."
          - conditions: "{{ prize == 'token' }}"
            sequence:
              - action: input_number.set_value
                target:
                  entity_id: "input_number.{{ w.id }}_extra_tokens"
                data:
                  value: "{{ states('input_number.' ~ w.id ~ '_extra_tokens') | int(0) + 1 }}"
        default:
          - action: input_number.set_value
            target:
              entity_id: "input_number.{{ w.screen }}_bonus_bank"
            data:
              value: "{{ states('input_number.' ~ w.screen ~ '_bonus_bank') | float(0) + << m.challenge_prize_minutes >> }}"
      - action: script.motivator_calendar_event
        data:
          calendar: calendar.bank_history
          summary: >-
            Chore Challenge Champion - {{ w.name }}:
            {{ {'bonus': '+<< m.challenge_prize_minutes >> min ' ~ w.screen_name ~ ' bonus', 'chore': loser_names ~ ' owe a chore', 'token': 'extra token'}[prize] }}
          description: "{{ standings }}"
          start_date: "{{ now().date() }}"
          end_date: "{{ (now() + timedelta(days=1)).date() }}"
<% endif %>

  # Sunday 12:05 PM: each person's week, sent to them (children's go to the parents too)
  - id: << uid >>_motivator_recap
    alias: "Motivator: Sunday recap"
    mode: single
    triggers:
      - trigger: time
        at: "12:05:00"
    conditions:
      - condition: time
        weekday: [sun]
    actions:
      - repeat:
          for_each: << recap_items | tojson >>
          sequence:
            - action: script.motivator_notify
              data:
                who: "{{ repeat.item.p }}"
                title: "{{ repeat.item.name }}'s week"
                message: >-
                  {{ states('input_text.' ~ repeat.item.p ~ '_last_week') }}
                  Exercise {{ state_attr('sensor.' ~ repeat.item.p ~ '_exercise_week', 'last_period') | float(0) | int }} min,
                  chores {{ state_attr('sensor.' ~ repeat.item.p ~ '_chores_week', 'last_period') | float(0) | int }} min{% if repeat.item.steps %},
                  {{ '{:,}'.format(state_attr('sensor.' ~ repeat.item.p ~ '_steps_week', 'last_period') | float(0) | int) }} steps{% endif %}.
